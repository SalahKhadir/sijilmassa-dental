# Development only. Set two distinct local passwords before starting PostgreSQL.
POSTGRES_DB=sijilmassa_dev
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://127.0.0.1:5432/sijilmassa_dev
DB_USERNAME=sijilmassa_dev
DB_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
SPRING_PROFILES_ACTIVE=dev
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Optional private prescription renderer (Spring process environment; disabled by default).
PRESCRIPTION_RENDERING_ENABLED=false
# Absolute, server-managed paths. Build the worker before enabling it.
# PRESCRIPTION_RENDERING_NODE_EXECUTABLE=/absolute/path/to/node
# PRESCRIPTION_RENDERING_WORKER_DIRECTORY=/absolute/path/to/frontend/.prescription-renderer
# PRESCRIPTION_RENDERING_MODULES_DIRECTORY=/absolute/path/to/frontend/node_modules
# Pin the exact SHA-256 printed by node scripts/build-prescription-renderer.mjs.
# PRESCRIPTION_RENDERING_MANIFEST_SHA256=
# PRESCRIPTION_RENDERING_TIMEOUT=5s
# PRESCRIPTION_RENDERING_MAX_PDF_BYTES=2097152

# Approved practitioner profile for finalization; absent by default (503, drafts unaffected).
# Server-owned UTF-8 JSON, outside source control. Match template and authenticated dentist UUID.
# PRESCRIPTION_PRACTITIONER_FILE=/absolute/private/path/practitioner.json
# PRESCRIPTION_PRACTITIONER_SHA256=
