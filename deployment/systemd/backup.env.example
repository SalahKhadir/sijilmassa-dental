# Copy to ~/.config/sijilmassa-clinic/backup.env and restrict to mode 0600.
# Absolute paths. This file contains paths and a public fingerprint only.
CLINIC_DEPLOYMENT_DIR=
CLINIC_ENV_FILE=
GNUPGHOME=
BACKUP_RECIPIENT=
BACKUP_DESTINATION=
BACKUP_MIN_FREE_KIB=1048576
# Set both for an external destination. Leave both empty for a local destination.
BACKUP_MOUNTPOINT=
BACKUP_MEDIA_ID=
