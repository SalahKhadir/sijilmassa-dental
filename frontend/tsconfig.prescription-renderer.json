{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": ".prescription-renderer",
    "noEmit": false,
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true,
    "plugins": [],
    "types": ["node"]
  },
  "include": ["src/server/prescription-renderer/**/*.ts"],
  "exclude": ["node_modules", ".next", ".prescription-renderer"]
}
